# ------------------------------------------------------------------------------
# Solidity / Truffle project .gitignore
# ------------------------------------------------------------------------------

# Node dependencies
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log
package-lock.json

# Truffle build artifacts
build/
artifacts/
cache/

# Environment files (secrets, private keys, RPC URLs)
.env
.env.*
*.env

# Coverage reports
coverage/
coverage.json

# Compiled contract JSONs (optional — if you don’t want them versioned)
# uncomment if build artifacts should never be committed
# build/contracts/

# IDE / Editor specific files
.idea/
.vscode/
*.swp
*.swo
*.iml

# OS / system files
.DS_Store
Thumbs.db

# Logs
*.log

# Ganache / local blockchain data
# Ganache GUI (old versions)
chaindata/
# Ganache CLI (default)
db/

# Temporary test results or output
.truffle/
.truffle-solidity-loader/

# Hardhat (if combined environment)
.cache/
artifacts/

# Typechain (if used)
typechain/
typechain-types/

# Optional: Ignore compiled ABIs & bytecode if you use TypeScript bindings
src/abi/

# ------------------------------------------------------------------------------
# End of file
# ------------------------------------------------------------------------------
